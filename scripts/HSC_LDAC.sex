
#-------------------------------- Catalog ------------------------------------

CATALOG_NAME    test.cat        # not used; command line forces
CATALOG_TYPE    FITS_LDAC      # "NONE","ASCII_HEAD","ASCII","FITS_1.0"
                                # or "FITS_LDAC"

PARAMETERS_NAME sextract.param   # name of the file containing catalog contents

#------------------------------- Extraction ----------------------------------
DETECT_TYPE     CCD             # "CCD" or "PHOTO"
DETECT_MINAREA  4               # minimum number of pixels above threshold
DETECT_THRESH   4              # <sigmas> or <threshold>,<ZP> in mag.arcsec-2
ANALYSIS_THRESH 4               # <sigmas> or <threshold>,<ZP> in mag.arcsec-2

FILTER          Y               # apply filter for detection ("Y" or "N")?
FILTER_NAME     default.conv    # name of the file containing the filter
DEBLEND_NTHRESH 64              # Number of deblending sub-thresholds; was 64
DEBLEND_MINCONT 0.01           # Minimum contrast ; was .0001
#
CLEAN           Y               # Clean spurious detections? (Y or N)?
CLEAN_PARAM     0.1             # Cleaning efficiency

MASK_TYPE       NONE         # type of detection MASKing: can be one of
                                # "NONE", "BLANK" or "CORRECT"
INTERP_MAXXLAG	1		# interpolate over mask, but only by 1 pixel
INTERP_MAXYLAG  1
INTERP_TYPE     ALL
#WEIGHT_TYPE	MAP_WEIGHT	#be sure to put the mask on the command line!

#------------------------------ Photometry -----------------------------------

PHOT_APERTURES  4,6,8,10,12               # MAG_APER aperture diameter(s) in pixels
PHOT_AUTOPARAMS 2., 3.5        # MAG_AUTO parameters: <Kron_fact>,<min_radius>

SATUR_LEVEL     60000.0         # level (in ADUs) at which arises saturation

MAG_ZEROPOINT   0.0             # magnitude zero-point
MAG_GAMMA       4.0             # gamma of emulsion (for photographic scans)
GAIN            3.5             # detector gain in e-/ADU
PIXEL_SCALE     .17               # size of pixel in arcsec (0=use FITS WCS info)
#------------------------- Star/Galaxy Separation ----------------------------

SEEING_FWHM     .5             # stellar FWHM in arcsec
STARNNW_NAME    /home/mbrown/subaru/proc/sextract/quest/default.nnw     # Neural-Network_Weight table filename

#------------------------------ Background -----------------------------------

BACK_SIZE       20              # Background mesh: <size> or <width>,<height>
BACK_FILTERSIZE 3               # Background filter: <size> or <width>,<height>

BACKPHOTO_TYPE  LOCAL          # can be "GLOBAL" or "LOCAL"

#------------------------------ Check Image ----------------------------------

CHECKIMAGE_TYPE NONE            # can be one of "NONE", "BACKGROUND",
                                # "MINIBACKGROUND", "-BACKGROUND", "OBJECTS",
                                # "-OBJECTS", "SEGMENTATION", "APERTURES",
                                # or "FILTERED"
CHECKIMAGE_NAME check.fits      # Filename for the check-image

#--------------------- Memory (change with caution!) -------------------------

MEMORY_OBJSTACK 20000            # number of objects in stack
MEMORY_PIXSTACK 2000000          # number of pixels in stack
MEMORY_BUFSIZE  2400            # number of lines in buffer

#----------------------------- Miscellaneous ---------------------------------

VERBOSE_TYPE    NORMAL          # can be "QUIET", "NORMAL" or "FULL"
